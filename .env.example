# Realtime Trains API access token
# Sign in at https://api-portal.rtt.io with an RTT unified login
# (accounts.realtimetrains.com) and request a token — free tier for
# personal, non-commercial use
RTT_API_TOKEN=your_rtt_access_token

# Train station CRS code (e.g., FOH for Forest Hill)
TRAIN_STATION_CRS=FOH

# Comma-separated destination CRS codes (e.g., LBG,HHY)
TRAIN_DESTINATIONS=LBG,HHY

# Weather location (latitude/longitude)
WEATHER_LATITUDE=51.4525
WEATHER_LONGITUDE=-0.0492

# iCal feed URLs (comma-separated)
# Get from: Google Calendar Settings > "Secret address in iCal format"
# Or: iCloud Calendar > Share > Public Calendar URL
ICAL_FEED_URLS=https://calendar.google.com/calendar/ical/example/basic.ics,webcal://p123-caldav.icloud.com/published/2/example
